Kino.Layout.tabs([
  {"Rooms", ui.rooms},
  {"Lights", lights_tab},
  {"Scenes", ui.scenes},
  {"Management", ui.management},
  {"Activity", ui.activity}
])
|> then(&Kino.Layout.grid([ui.status, &1], columns: 1))
